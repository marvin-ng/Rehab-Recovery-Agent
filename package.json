{
  "name": "rehab-recovery-agent",
  "version": "0.1.0",
  "description": "Always-on AWS agent that organizes, reminds, tracks, and summarizes a prescribed physio program.",
  "private": true,
  "scripts": {
    "seed": "node scripts/seed-program.mjs",
    "verify": "node scripts/verify-data.mjs",
    "build:tagging": "esbuild src/tagging/handler.mjs --bundle --platform=node --format=cjs --target=node22 --external:@aws-sdk/* --outfile=dist/tagging/index.js",
    "build:log-session": "esbuild src/log-session/handler.mjs --bundle --platform=node --format=cjs --target=node22 --external:@aws-sdk/* --outfile=dist/log-session/index.js",
    "build:dashboard-data": "esbuild src/dashboard-data/handler.mjs --bundle --platform=node --format=cjs --target=node22 --external:@aws-sdk/* --outfile=dist/dashboard-data/index.js",
    "build:nudge": "esbuild src/nudge/handler.mjs --bundle --platform=node --format=cjs --target=node22 --external:@aws-sdk/* --outfile=dist/nudge/index.js",
    "build:digest": "esbuild src/digest/handler.mjs --bundle --platform=node --format=cjs --target=node22 --external:@aws-sdk/* --outfile=dist/digest/index.js",
    "verify:tagging": "node scripts/verify-tagging.mjs",
    "verify:logic": "node scripts/verify-logic.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "esbuild": "^0.28.1"
  }
}
